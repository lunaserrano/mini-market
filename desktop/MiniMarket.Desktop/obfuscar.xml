<?xml version="1.0" encoding="utf-8"?>
<!--
  Ofuscación del cliente WinForms (Obfuscar). Se ejecuta automáticamente al publicar con
  -p:Obfuscate=true (ver build/Obfuscar.targets); rutas relativas a la carpeta de publicación.

  Excluido a propósito:
  - MiniMarket.Desktop.Api.Models: System.Text.Json los mapea por nombre de propiedad.
  - Tipos enlazados a grillas/combos por nombre (LineaCarrito, FilaPago, Opcion<T>...): marcados en
    código con [Obfuscation(Exclude = true)], que Obfuscar respeta.
-->
<Obfuscator>
  <Var name="InPath" value="." />
  <Var name="OutPath" value=".\obfuscated" />
  <Var name="KeepPublicApi" value="true" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="HideStrings" value="true" />
  <Var name="RenameProperties" value="true" />
  <Var name="RenameEvents" value="true" />
  <Var name="RenameFields" value="true" />
  <Var name="UseUnicodeNames" value="true" />

  <Var name="SuppressIldasm" value="true" />

  <Module file="$(InPath)\MiniMarket.Desktop.dll">
    <SkipNamespace name="MiniMarket.Desktop.Api.Models" />
    <!-- Tipos anónimos (new { empresaId, id }): el compilador los genera FUERA de su namespace, así que
         SkipNamespace no los cubre. Dapper/System.Text.Json leen sus propiedades por nombre. -->
    <SkipType rx="^&lt;&gt;f__AnonymousType.*" skipMethods="true" skipProperties="true" skipFields="true" skipEvents="true" />
  </Module>

  <!-- Api embebida (Services/ApiLocal.cs): mismas reglas que backend/src/MiniMarket.Api/obfuscar.xml.
       KeepPublicApi=true conserva lo que DI, controllers, model binding, FluentValidation y Dapper usan
       por reflexión. Persistence se excluye: Dapper materializa tipos privados por nombre. -->
  <Module file="$(InPath)\MiniMarket.Application.dll">
    <SkipType rx="^&lt;&gt;f__AnonymousType.*" skipMethods="true" skipProperties="true" skipFields="true" skipEvents="true" />
  </Module>
  <Module file="$(InPath)\MiniMarket.Infrastructure.dll">
    <SkipNamespace name="MiniMarket.Infrastructure.Persistence" />
    <SkipNamespace name="MiniMarket.Infrastructure.Persistence.Repositories" />
    <SkipType rx="^&lt;&gt;f__AnonymousType.*" skipMethods="true" skipProperties="true" skipFields="true" skipEvents="true" />
  </Module>
</Obfuscator>
