<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <AssemblyName>MiniMarket.Desktop</AssemblyName>
    <RootNamespace>MiniMarket.Desktop</RootNamespace>
    <Product>MiniMarket POS</Product>
    <Version>1.0.0</Version>
    <!-- El cliente NO referencia ningún proyecto del backend ni SqlClient: solo habla HTTP con la Api. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.9" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.13" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="obfuscar.xml" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!-- Ofuscación al publicar con -p:Obfuscate=true (ver build/Obfuscar.targets y obfuscar.xml). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Obfuscar.targets" />

</Project>
