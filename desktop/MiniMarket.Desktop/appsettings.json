{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Jwt": {
    "Issuer": "MiniMarket.Api",
    "Audience": "MiniMarket.Clients",
    "Key": "",
    "AccessTokenMinutes": 15
  },

  "Seguridad": {
    "MaxIntentosFallidos": 5,
    "MinutosBloqueo": 15,
    "RefreshTokenDays": 7
  },

  "Auditoria": {
    "Habilitada": true
  },

  "Seed": {
    "Enabled": true
  },

  "Api": {
    "SwaggerEnabled": false,
    "TimeoutSegundos": 30,
    "HealthIntervaloSegundos": 15
  },

  "Sync": {
    "Enabled": false,
    "AzureApiUrl": "",
    "IntervaloMinutos": 5,
    "TamanoLote": 200
  },

  "AllowedOrigins": [],

  "Ticket": {
    "AnchoMm": 80,
    "Impresora": ""
  }
}
