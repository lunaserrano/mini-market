<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MiniMarket.ConfigTool</AssemblyName>
    <RootNamespace>MiniMarket.ConfigTool</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.13" />
  </ItemGroup>

  <!-- Mismo cifrado que usa la Api al arrancar: se enlaza el archivo fuente (no el proyecto) para
       no arrastrar Dapper/DbUp/JWT a una herramienta de instalación. -->
  <ItemGroup>
    <Compile Include="..\..\src\MiniMarket.Infrastructure\Security\DpapiProtector.cs" Link="Security\DpapiProtector.cs" />
    <Compile Include="..\..\src\MiniMarket.Infrastructure\Security\SecretosLocales.cs" Link="Security\SecretosLocales.cs" />
  </ItemGroup>

</Project>
