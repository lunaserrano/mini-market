# ============================================================
# Monorepo root — backend/ (.NET) + frontend/ (Angular, tiene su propio .gitignore) + database/
# ============================================================

# --- .NET (backend/) ---
**/bin/
**/obj/
**/.vs/
*.user
*.suo

# appsettings con secretos locales (connection strings con contraseña, claves, etc.).
# appsettings.Development.json SÍ se versiona: usa autenticación integrada de Windows, sin secretos.
# El JWT:Key de desarrollo vive en dotnet user-secrets (fuera del repo), no en appsettings.
**/appsettings.Local.json
**/appsettings.Production.json
**/secrets.json
# Secretos del modo Desktop (connection string y Jwt:Key cifrados con DPAPI por MiniMarket.ConfigTool).
# Son específicos de cada máquina: no sirven en otra PC y no se versionan.
**/appsettings.Secrets.json

# Salida de publish.ps1 (instalables del modo Desktop)
/dist/

# --- IDEs y editores ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
.history/*

# --- Sistema operativo ---
.DS_Store
Thumbs.db

# Nota: frontend/ tiene su propio .gitignore (node_modules, dist, .angular/cache, etc.)
# generado por Angular CLI — no se duplica aquí.
